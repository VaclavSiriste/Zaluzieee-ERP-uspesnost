# .env.example

# PostgreSQL Connection String pro ERP databázi
ERP_DB_CONNECTION_STRING=postgres://user:password@host:port/database

# SSL Certifikát pro bezpečné připojení (volitelné)
ERP_DB_CA_CERT=-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----

# Daktela / Pohoda CC (Supabase) — speciální znaky v hesle URL-enkódujte (& → %26, % → %25)
DAKTELA_DB_CONNECTION_STRING=postgresql://user:password@host.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
DAKTELA_DB_SSL=true
# DAKTELA_DB_CA_CERT=volitelné, jinak ssl s rejectUnauthorized=false

# Next.js environment
NODE_ENV=development

# Veřejná URL aplikace (magic link v e-mailu)
APP_URL=http://localhost:3100

# Podpis session a přihlašovacích tokenů
APP_AUTH_SECRET=change_me_to_long_random_string

# SMTP pro odeslání přihlašovacího kódu
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@zaluzieee.cz
SMTP_PASS=your_smtp_password
SMTP_FROM=Dashboard <noreply@zaluzieee.cz>

# Systeeem Orders API
SYSTEEEM_API_URL=https://api.systeeem.cz/api
SYSTEEEM_API_TOKEN=your_bearer_token_here

# Preferované – sync na Railway (rychlejší než GitHub Actions)
# Viz pohoda/RAILWAY-DAKTELA-SYNC.md
# DAKTELA_SYNC_RAILWAY_URL=https://xxx.up.railway.app
# DAKTELA_SYNC_API_TOKEN=stejny_secret_jako_API_TOKEN_na_Railway

# Fallback – ruční sync přes GitHub Actions (produkce bez Railway sync služby)
# GITHUB_SYNC_TOKEN=ghp_...
# GITHUB_SYNC_REPO=VaclavSiriste/pohoda
# GITHUB_SYNC_WORKFLOW=daktela-pause-sync.yml
# GITHUB_SYNC_REF=main
# POHODA_SYNC_ROOT=/cesta/k/pohoda

# pokladamee OVT sheet — Apps Script web app
# Viz scripts/google-apps-script-pokladamee-ovt.gs
# POKLADAMEE_OVT_SHEET_WEBAPP_URL=https://script.google.com/macros/s/.../exec
# POKLADAMEE_OVT_SHEET_TOKEN=pokladamee-ovt-2026

# malujemeee OVT sheet — Apps Script web app
# Viz scripts/google-apps-script-malujemeee-ovt.gs
# MALUJEMEEE_OVT_SHEET_WEBAPP_URL=https://script.google.com/macros/s/.../exec
# MALUJEMEEE_OVT_SHEET_TOKEN=malujemeee-ovt-2026

# Alternativa: GOOGLE_SERVICE_ACCOUNT_JSON={...}
