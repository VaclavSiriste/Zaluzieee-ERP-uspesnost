# .env.example

# PostgreSQL Connection String pro ERP databázi
ERP_DB_CONNECTION_STRING=postgres://user:password@host:port/database

# SSL Certifikát pro bezpečné připojení (volitelné)
ERP_DB_CA_CERT=-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----

# Next.js environment
NODE_ENV=development

# Systeeem Orders API
SYSTEEEM_API_URL=https://api.systeeem.cz/api
SYSTEEEM_API_TOKEN=your_bearer_token_here
